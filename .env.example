# ========================================================
# Application Environment Configuration
# ========================================================

# TELEGRAM_BOT_TOKEN: The API token for your Telegram Bot from BotFather.
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# JWT_SECRET: Secret for signing JWT authentication tokens.
# REQUIRED in production — the server refuses to start without it (an insecure
# fallback is only used in development, with a warning).
JWT_SECRET="your_jwt_secret_here"

# PORT: The port the server runs on (Must be 3000 in AI Studio)
PORT=3000

# NODE_ENV: 'development' or 'production'
NODE_ENV="development"

# PADDLE_OCR_URL: Open-Source PaddleOCR Microservice endpoint for unlimited offline screenshot OCR
# Default is http://127.0.0.1:5000/ocr (managed together via PM2 / Docker)
PADDLE_OCR_URL="http://127.0.0.1:5000/ocr"

# ========================================================
# Database Configuration (CloudPanel / phpMyAdmin Dual-Mode)
# ========================================================
# DB_TYPE: 'mysql' for CloudPanel MySQL/phpMyAdmin, or 'sqlite' for local file database.
# If DB_TYPE is 'mysql' but MySQL is unreachable, the app automatically falls back to SQLite.
DB_TYPE="mysql"

# MySQL Host (usually 127.0.0.1 if running on same CloudPanel VPS, or remote server IP)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"

# CloudPanel Database Name, User, and Password (from CloudPanel -> Databases tab)
MYSQL_DATABASE="payment_gateway"
MYSQL_USER="payment_user"
MYSQL_PASSWORD="your_strong_mysql_password_here"

# EXTENSION_API_KEY: A long-lived secret key for the browser extension to call
# POST /api/order without needing to re-login every 24h like the dashboard JWT.
# Generate any long random string, e.g.: openssl rand -hex 32
EXTENSION_API_KEY=""

# ========================================================
# Playwright Headless Automation & Scraper Configuration
# ========================================================
# SCRAPER_ENABLED: Automatically start the headless crawler when server boots ('true' or 'false')
SCRAPER_ENABLED="false"

# Target Portal Login & Withdrawal Orders URLs
SCRAPER_PORTAL_URL="https://example.com/portal/login"
SCRAPER_ORDERS_URL="https://example.com/portal/withdrawals"

# Portal Agent / Admin Credentials
SCRAPER_USERNAME=""
SCRAPER_PASSWORD=""

# Polling Interval in seconds (default: 20)
SCRAPER_POLL_INTERVAL=20

